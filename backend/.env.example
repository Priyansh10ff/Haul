# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=8001

# MongoDB connection string (Atlas or local)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopkart

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me

# Frontend origin(s) allowed by CORS. Comma-separate several.
CLIENT_URL=http://localhost:5173

# Optional. Razorpay API keys (Dashboard → Account & Settings → API Keys); use rzp_test_ keys in development.
# Leave both empty to run without payments: everything works except checkout, which
# answers "Payments are not configured on the server yet."
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
